# Copy to .env for local development: cp .env.example .env
# Never commit .env. Production values are set in the Render and Vercel dashboards.

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# --- Local Postgres (docker compose) ---
POSTGRES_USER=campus
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=campus_ai
# 5433 avoids clashing with a Postgres already installed on 5432
POSTGRES_HOST_PORT=5433
# Must match the four values above when running the backend on your machine
DATABASE_URL=postgresql+asyncpg://campus:local_dev_only@localhost:5433/campus_ai

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Filled in at later milestones (safe to leave blank for now) ---
# Milestone 1-2: embeddings and re-ranking
VOYAGE_API_KEY=
# Pacing for embedding runs. Raise these after adding a payment method on Voyage.
VOYAGE_RPM=3
VOYAGE_TPM=10000
# Retrieval: vector | keyword | hybrid
RETRIEVAL_MODE=hybrid
RERANK_ENABLED=true
# Hide emails and phone numbers in stored text
MASK_CONTACT_DETAILS=true
# Blank disables POST /admin/documents
ADMIN_API_KEY=
# Milestone 3: LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Best re-rank score needed before the LLM is called at all
REFUSAL_MIN_RERANK_SCORE=0.55
# Milestone 5: auth
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Milestone 6: email
RESEND_API_KEY=
